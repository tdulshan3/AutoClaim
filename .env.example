# Optional. Profiles are normally added through the UI, which is the better
# route because it reads the account name back from the site as you add it.
# These are only used to seed the very first profile on a fresh install, and
# are ignored once any profile exists.

# A connect.sid cookie from xm100.vn. Paste it in any of these shapes:
#   s:xxxxx.yyyyy          (what devtools > Application > Cookies shows)
#   s%3Axxxxx.yyyyy        (what actually goes on the wire)
#   connect.sid=s%3Axxxxx  (a whole cookie pair)
CONNECT_SID=

# "ase" (Survival Evolved) or "asa" (Survival Ascended)
SERVER_TYPE=ase

# The timezone the attendance day rolls over in. xm100.vn is Vietnamese, so its
# day almost certainly starts at midnight UTC+7 - not at midnight where you are.
CLAIM_TIMEZONE=Asia/Ho_Chi_Minh

PORT=8787
